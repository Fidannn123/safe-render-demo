# SafePay local configuration. Copy to .env (gitignored) only if you need to change a default.
# NO SECRETS HERE: passwords, Django keys, pepper, KEK and signing keys are generated into
# ops/dev-keys/ (gitignored) by `make keys` or automatically by the compose keygen service.
# Compose reads this file with: docker compose -f ops/docker-compose.yml --env-file .env ...

# demo = T2 cool-off 600 s; prod = 14400 s (spec/policy.yaml timing.t2_cooloff_seconds)
SAFEPAY_MODE=demo

# LLM provider. Default is the deterministic mock; CI and tests always use the mock.
SAFEPAY_LLM=mock
# Only when SAFEPAY_LLM=anthropic: pinned model id and your key (never commit a real key).
SAFEPAY_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Host port for PostgreSQL 18 (bound to 127.0.0.1 only); tests connect here.
SAFEPAY_PG_PORT=55432

LOG_LEVEL=INFO
