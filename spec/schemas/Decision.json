{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision",
  "description": "Guardian output (architecture.md section 6). Signed with Ed25519 over the RFC 8785 canonical JSON of every field except sig. Single use (nonce UNIQUE), bound to the exact payment fields, expires at expires_at (= issued_at + policy decision_ttl_seconds). Fields added to architecture.md: payment_id, issued_at, key_id (DECISIONS.md D-011).",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "tenant_id", "payment_id", "verdict", "tier", "payment", "score", "reasons", "policy_version", "network_epoch", "inputs_sha256", "nonce", "issued_at", "expires_at", "key_id", "sig"],
  "properties": {
    "decision_id": { "$ref": "common.json#/$defs/Uuid" },
    "tenant_id": { "$ref": "common.json#/$defs/Uuid" },
    "payment_id": { "$ref": "common.json#/$defs/Uuid", "description": "Also used as the bank end_to_end_id." },
    "verdict": { "$ref": "common.json#/$defs/Verdict" },
    "tier": {
      "oneOf": [ { "$ref": "common.json#/$defs/Tier" }, { "type": "null" } ],
      "description": "T1 for ALLOW, T2 for GUARDED, T3 for HOLD, null for DENY."
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor_id", "account_id", "amount_minor", "currency", "invoice_fingerprint"],
      "properties": {
        "vendor_id": { "$ref": "common.json#/$defs/Uuid" },
        "account_id": { "$ref": "common.json#/$defs/Uuid" },
        "amount_minor": { "$ref": "common.json#/$defs/AmountMinor" },
        "currency": { "$ref": "common.json#/$defs/Currency" },
        "invoice_fingerprint": { "$ref": "common.json#/$defs/Sha256Hex", "description": "SHA-256(vendor_id | normalised reference | amount_minor | currency)." }
      }
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "reasons": { "type": "array", "maxItems": 32, "items": { "$ref": "common.json#/$defs/Reason" } },
    "policy_version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]+$" },
    "network_epoch": { "type": ["integer", "null"], "minimum": 0, "description": "Intel epoch consulted; null when the network check was skipped (known payee)." },
    "inputs_sha256": { "$ref": "common.json#/$defs/Sha256Hex", "description": "SHA-256 of the RFC 8785 canonical JSON of all decide() inputs; enables replay." },
    "nonce": { "$ref": "common.json#/$defs/NonceHex" },
    "issued_at": { "$ref": "common.json#/$defs/Timestamp" },
    "expires_at": { "$ref": "common.json#/$defs/Timestamp" },
    "key_id": { "$ref": "common.json#/$defs/KeyId" },
    "sig": { "$ref": "common.json#/$defs/Ed25519Signature" }
  },
  "allOf": [
    { "if": { "properties": { "verdict": { "const": "ALLOW" } }, "required": ["verdict"] }, "then": { "properties": { "tier": { "const": "T1" } } } },
    { "if": { "properties": { "verdict": { "const": "GUARDED" } }, "required": ["verdict"] }, "then": { "properties": { "tier": { "const": "T2" } } } },
    { "if": { "properties": { "verdict": { "const": "HOLD" } }, "required": ["verdict"] }, "then": { "properties": { "tier": { "const": "T3" } } } },
    { "if": { "properties": { "verdict": { "const": "DENY" } }, "required": ["verdict"] }, "then": { "properties": { "tier": { "type": "null" } } } }
  ],
  "examples": [
    {
      "decision_id": "5c4b3a29-1807-4f6e-9d5c-4b3a29180700",
      "tenant_id": "11111111-2222-4333-8444-555555555555",
      "payment_id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
      "verdict": "HOLD",
      "tier": "T3",
      "payment": {
        "vendor_id": "2b8f6a1e-3c4d-4e5f-8a9b-0c1d2e3f4a5b",
        "account_id": "9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d",
        "amount_minor": 125000,
        "currency": "USD",
        "invoice_fingerprint": "1111111111111111111111111111111111111111111111111111111111111111"
      },
      "score": 80,
      "reasons": [
        { "code": "BANK_DETAIL_MISMATCH", "weight": 50, "detail": "Invoice IBAN differs from registry account." },
        { "code": "INJECTION_MARKERS", "weight": 30, "detail": "Instruction-like text in untrusted field memo." }
      ],
      "policy_version": "2026.10.19-1",
      "network_epoch": null,
      "inputs_sha256": "2222222222222222222222222222222222222222222222222222222222222222",
      "nonce": "00112233445566778899aabbccddeeff",
      "issued_at": "2026-10-19T08:00:05Z",
      "expires_at": "2026-10-19T08:15:05Z",
      "key_id": "tenant-11111111:decision:1",
      "sig": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=="
    }
  ]
}
